// ======================================================================
//  HƯỚNG DẪN: sao chép tệp này thành "appsettings.Development.json" (cùng thư mục)
//  rồi điền các giá trị. Tệp .Development.json đã được .gitignore nên
//  KEY/MẬT KHẨU KHÔNG bị đẩy lên Git (đúng yêu cầu bảo mật — RSK/SEC).
//
//  Ô nào chưa có giá trị THẬT thì để TRỐNG. Đừng để giá trị giữ chỗ: app coi
//  chuỗi khác rỗng là "đã cấu hình" và gọi thật — hỏng — thay vì tự lùi về
//  chế độ chấm offline / không gửi email.
// ======================================================================
{
  // ---- (0) Chuỗi kết nối — CHỈ cần khi máy bạn KHÔNG dùng SQL Server Express ----
  //  appsettings.json mặc định trỏ localhost\SQLEXPRESS. Máy chạy bản thường
  //  (PowerShell: Get-Service MSSQL* ra "MSSQLSERVER") thì bỏ comment 3 dòng dưới.
  // "ConnectionStrings": {
  //   "DefaultConnection": "Server=localhost;Database=ITCareerPlatform;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  // },

  // ---- (1) AI Gemini (tùy chọn) ----
  //  Để trống -> hệ thống tự chấm điểm bằng thuật toán offline (vẫn chạy).
  //  Lấy key MIỄN PHÍ: https://aistudio.google.com/apikey
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-1.5-flash"
  },

  // ---- (2) SMTP gửi email THẬT (tùy chọn) ----
  //  Để trống Host + From -> email xếp hàng chờ, mật khẩu tạm hiện cho Admin đọc.
  //  Điền đủ -> đặt lại mật khẩu / duyệt HR / đổi trạng thái đơn gửi thẳng email.
  //  Gmail (khuyến nghị cho đồ án):
  //    1. Bật xác thực 2 bước cho Gmail.
  //    2. Tạo "App password" 16 ký tự: https://myaccount.google.com/apppasswords
  //    3. Host = "smtp.gmail.com", User = From = email Gmail, Password = App password.
  "Smtp": {
    "Host": "",
    "Port": "587",
    "EnableSsl": "true",
    "User": "",
    "Password": "",
    "From": ""
  }
}
