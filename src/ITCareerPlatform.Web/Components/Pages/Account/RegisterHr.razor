@page "/register-hr"
@layout EmptyLayout
@attribute [AllowAnonymous]

@* HR-REG: Nhà tuyển dụng / HR / Mentor đăng ký tài khoản (chờ duyệt) *@

<div class="login-split-container">
    <div class="login-split-banner">
        <img class="login-split-img" src="https://www.vietnamworks.com/hrinsider/wp-content/uploads/2022/10/nghe-it-4.jpg" alt="IT Career Platform Banner" />
        <div class="login-split-overlay"></div>
        <div class="login-split-text">
            <span class="login-split-tag">Dành cho Nhà Tuyển Dụng</span>
            <h2>Tìm kiếm nhân tài công nghệ xuất sắc</h2>
            <p>Đăng tin tuyển dụng IT, tiếp cận hàng nghìn hồ sơ ứng viên chất lượng và ứng dụng AI tự động hóa sàng lọc CV nhanh chóng.</p>
        </div>
    </div>
    <div class="login-split-form-wrap">
        <div class="login-card" style="max-width: 480px;">
            <div class="brand-lg">IT Career<span>PLATFORM</span></div>
            <h1>Đăng ký — Nhà tuyển dụng / HR IT</h1>
            @if (!string.IsNullOrEmpty(ErrorMsg)) { <div class="alert-err">@ErrorMsg</div> }
            <form method="post" action="/account/register-hr" data-vi-validate>
                <AntiforgeryField />
                <label>Họ và tên người đại diện</label>
                <input name="fullName" required minlength="2" placeholder="Nguyễn Văn A" />
                <label>Email doanh nghiệp</label>
                <input name="email" type="email" required placeholder="hr@congty.com" />
                <label>Tên công ty / Tổ chức</label>
                <input name="companyName" required minlength="2" placeholder="Công ty Cổ phần Công nghệ XYZ" />
                <label>Mật khẩu (tối thiểu 8 ký tự)</label>
                <input name="password" type="password" required minlength="8" placeholder="••••••••" />
                <label>Xác nhận mật khẩu</label>
                <input name="confirmPassword" type="password" required minlength="8" placeholder="••••••••" />
                <button class="btn-primary full" type="submit" style="margin-top: 14px;">Gửi yêu cầu đăng ký HR</button>
            </form>
            <div class="hint">
                <div>Đã có tài khoản? <a href="/login">Đăng nhập ngay</a></div>
                <div style="margin-top:6px">Bạn là ứng viên? <a href="/register">Đăng ký Sinh viên IT</a></div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorMsg { get; set; }
}
