@page "/users"
@attribute [Authorize(Roles = Roles.Admin)]
@inject IUserService Users
@inject IHttpContextAccessor Http
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtection

<div class="page-head">
    <h1 class="page-title">Quản lý tài khoản</h1>
    <a class="btn-primary" href="/users/new">+ Tạo tài khoản</a>
</div>

@if (!string.IsNullOrEmpty(Err)) { <div class="alert-err">@Err</div> }
@if (pendingCount > 0)
{
    <div class="info-banner" style="margin-bottom:16px;">
        ⏳ Có <b>@pendingCount</b> tài khoản HR đang chờ duyệt. <a href="/users/pending"><b>Xem và duyệt ngay &rarr;</b></a>
    </div>
}

<table class="tbl">
    <thead>
        <tr><th>ID</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Phân quyền</th><th>Đặt lại MK</th><th>Khóa</th></tr>
    </thead>
    <tbody>
        @foreach (var u in userList)
        {
            var isSelf = u.Id == currentUid;
            <tr>
                <td>@u.Id</td>
                <td>@u.FullName @(isSelf ? "(bạn)" : "")</td>
                <td>@u.Email</td>
                <td><span class="tag">@Roles.Display(u.Role?.RoleName ?? "")</span></td>
                <td>@if (u.IsActive) { <span class="ok">● Hoạt động</span> } else { <span class="lock">● Đã khóa</span> }</td>
                <td>
                    @if (isSelf)
                    {
                        <span class="sub">— (không thể tự đổi)</span>
                    }
                    else
                    {
                        <form method="post" action="@($"/users/{u.Id}/change-role")" class="inline">
                            <AntiforgeryToken />
                            <select name="roleId">
                                @foreach (var r in roleList)
                                {
                                    <option value="@r.Id" selected="@(r.Id == u.RoleId)">@Roles.Display(r.RoleName)</option>
                                }
                            </select>
                            <button class="btn-sm" type="submit">Lưu</button>
                        </form>
                    }
                </td>
                <td>
                    @if (isSelf)
                    {
                        <span class="sub">—</span>
                    }
                    else
                    {
                        @* Form POST THẬT, đúng route của dòng này. Cả trang render tĩnh, không
                           có Blazor interactivity — mọi thao tác Admin khác cũng là form thuần.
                           openResetModal trả false khi mở được hộp thoại (dừng lần gửi này lại
                           để Admin gõ mật khẩu tay), và trả true khi không mở được — lúc đó
                           form cứ gửi như thường và hệ thống tự sinh mật khẩu. Nhờ vậy một lỗi
                           JavaScript không lấy mất đường cứu tài khoản bị khóa. *@
                        <form method="post" action="@($"/users/{u.Id}/reset-password")" class="inline"
                              onsubmit="return openResetModal(this, '@EscapeJs(u.FullName)', '@EscapeJs(u.Email)');">
                            <AntiforgeryToken />
                            @* Ô mật khẩu tay: hộp thoại điền vào đây rồi gửi CHÍNH form này.
                               Không có JavaScript thì ô để trống và hệ thống tự sinh mật khẩu —
                               đúng hành vi cũ, và vẫn là một form POST hoàn chỉnh. *@
                            <input type="hidden" name="newPassword" value="" />
                            <button class="btn-sm" style="background:#d97706;color:#fff;" type="submit"
                                    title="Đặt lại mật khẩu cho @u.FullName">
                                Đặt lại MK
                            </button>
                        </form>
                    }
                </td>
                <td>
                    @if (isSelf)
                    {
                        <span class="sub">—</span>
                    }
                    else
                    {
                        <form method="post" action="@($"/users/{u.Id}/toggle-lock")" class="inline" onsubmit="return confirm('Bạn chắc chắn muốn khóa/mở khóa tài khoản này?');">
                            <AntiforgeryToken />
                            <button class="btn-sm @(u.IsActive ? "danger" : "")" type="submit">@(u.IsActive ? "Khóa" : "Mở khóa")</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="sub" style="margin-top:12px">
    Khóa tài khoản hoặc đổi vai trò có hiệu lực <b>ngay lập tức</b>: phiên đăng nhập đang mở
    của tài khoản đó bị từ chối ở request kế tiếp.
</p>

<!-- Giai đoạn 1: Dialog xác nhận & thiết lập đặt lại mật khẩu -->
@*
   Hộp thoại này KHÔNG phải một form. Nó chỉ thu mật khẩu tay rồi gửi form của đúng dòng vừa
   bấm — dòng nào cũng đã là một form POST hoàn chỉnh, có action thật và có token.
   Một form thứ hai ở đây sẽ phải mang action render sẵn, mà lúc render thì chưa biết bấm
   vào dòng nào: bản trước đặt action là "/users/0/reset-password", một route không tồn tại.
*@
<dialog id="resetPasswordModal" class="app-modal">
    <div class="modal-box">
        <div class="modal-head">
            <h2 id="modalTargetTitle">Đặt lại mật khẩu cho tài khoản</h2>
            <button type="button" class="modal-close" onclick="closeResetModal()">&times;</button>
        </div>
        <div class="modal-body">
            <p id="modalTargetDesc" class="sub" style="margin: 0;"></p>
            <div>
                <label for="newPasswordInput" style="font-weight: 600; font-size: 13.5px; display: block; margin-bottom: 6px;">
                    Mật khẩu mới (tùy chọn)
                </label>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <div style="position: relative; flex: 1;">
                        <input id="newPasswordInput" type="password"
                               placeholder="Nhập mật khẩu mới hoặc để trống để tự sinh"
                               style="width: 100%; padding-right: 42px;" />
                        <button type="button" id="togglePasswordBtn" onclick="togglePasswordVisibility()"
                                style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 16px; padding: 4px;"
                                title="Hiện / Ẩn mật khẩu">
                            👁️
                        </button>
                    </div>
                    <button type="button" class="btn-sm" onclick="suggestPassword()" style="white-space: nowrap; height: 38px; display: inline-flex; align-items: center; gap: 4px;">
                        ⚡ Gợi ý
                    </button>
                </div>
            </div>
            <div class="modal-hint">
                💡 <b>Ghi chú:</b> Nếu để trống: Hệ thống sẽ tự tạo mật khẩu tạm thời ngẫu nhiên và gửi thẳng về email của người dùng (nếu hệ thống đã cấu hình SMTP).
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn" onclick="closeResetModal()">Hủy</button>
            <button type="button" class="btn-primary" style="background:#1f4e79;" onclick="confirmReset()">Xác nhận đặt lại</button>
        </div>
    </div>
</dialog>

<!-- Giai đoạn 2: Dialog thông báo kết quả -->
@*
   Một nguồn duy nhất: cookie one-shot mô tả trọn kết cục (đã gửi email / phải tự đọc / gửi
   hỏng, và mật khẩu do Admin gõ hay hệ thống sinh). Không còn tổ hợp cờ nào để mâu thuẫn,
   nên cũng không còn nhánh nào có thể vẽ ra một ô mật khẩu RỖNG.
   Cờ ?tempPw=1 trên URL chỉ nói "vừa có một lần đặt lại" — đủ để giải thích khi Admin tải
   lại trang và mật khẩu đã hết hiệu lực hiển thị.
*@
@if (hasResult)
{
    <dialog id="resultModal" class="app-modal">
        <div class="modal-box">
            @if (result is null)
            {
                <div class="modal-head">
                    <h2>⚠️ Thông báo mật khẩu tạm</h2>
                    <button type="button" class="modal-close" onclick="closeResultModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="alert-err" style="margin: 0;">
                        Mật khẩu tạm chỉ hiện một lần và đã hết hiệu lực hiển thị. Nếu chưa kịp ghi lại, hãy bấm "Đặt lại MK" thêm một lần nữa.
                    </div>
                </div>
            }
            else if (result.Delivery == ResetDelivery.Emailed)
            {
                <div class="modal-head">
                    <h2>📧 Đã gửi mật khẩu tạm thời thành công</h2>
                    <button type="button" class="modal-close" onclick="closeResultModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="info-banner">
                        @(result.Manual
                            ? "Mật khẩu bạn vừa thiết lập đã được gửi tự động tới hòm thư của người dùng."
                            : "Hệ thống đã tự sinh mật khẩu tạm thời và gửi email tự động tới hòm thư của người dùng.")
                    </div>
                    <p class="sub" style="margin: 0; font-size: 14.5px;">
                        Đã gửi tới <b>@result.TargetEmail</b>. Người dùng phải đổi mật khẩu ngay khi đăng nhập.
                    </p>
                </div>
            }
            else
            {
                <div class="modal-head">
                    <h2>@(result.Manual ? "✅ Đặt lại mật khẩu thành công" : "🔑 Đặt lại mật khẩu tạm thời thành công")</h2>
                    <button type="button" class="modal-close" onclick="closeResultModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <p style="margin: 0; font-size: 14.5px;">
                        @(result.Manual ? "Mật khẩu bạn vừa thiết lập" : "Mật khẩu tạm thời")@(string.IsNullOrEmpty(result.TargetEmail) ? "" : " cho tài khoản"):
                        @if (!string.IsNullOrEmpty(result.TargetEmail)) { <b>@result.TargetEmail</b> }
                    </p>
                    <div class="pw-display-box">
                        <code class="pw-code" style="letter-spacing: 1px;">@result.Password</code>
                        @* EscapeJs, không phải @result.Password trần: mật khẩu Admin gõ tay có thể
                           chứa dấu nháy, và nháy chưa escape làm cả câu lệnh onclick thành lỗi cú
                           pháp — nút im lặng không làm gì, mà mật khẩu chỉ hiện đúng một lần. *@
                        <button type="button" class="btn-sm" style="background:#16a34a;" onclick="copyPassword('@EscapeJs(result.Password)', this)">Sao chép</button>
                    </div>
                    @if (result.Manual)
                    {
                        <div class="info-banner">
                            📌 <b>Ghi chú:</b> Người dùng sẽ dùng mật khẩu này để đăng nhập và bắt buộc phải đổi mật khẩu mới ngay lần đầu tiên.
                        </div>
                    }
                    <div class="warn-banner">
                        ⚠️ <b>Lưu ý:</b> Do @(result.Delivery == ResetDelivery.ShownAfterMailFailure ? "gửi email thất bại" : "chưa cấu hình gửi email SMTP"), mật khẩu này CHỈ hiển thị 1 lần duy nhất tại hộp thoại này. Vui lòng sao chép và gửi trực tiếp cho HR/Sinh viên IT.
                    </div>
                </div>
            }
            <div class="modal-foot">
                <button type="button" class="btn-primary" onclick="closeResultModal()">Đã hiểu / Đóng</button>
            </div>
        </div>
    </dialog>
}

<script>
    // Form của dòng nào đang chờ hộp thoại điền mật khẩu.
    var pendingResetForm = null;

    // Trả về false = đã mở hộp thoại, chặn lần gửi form này lại để Admin gõ mật khẩu tay.
    // Trả về true  = không mở được (trình duyệt không hỗ trợ <dialog>, hoặc markup thiếu),
    //                để form gửi thẳng và hệ thống tự sinh mật khẩu. Nhờ vậy một lỗi
    //                JavaScript không lấy mất đường cứu tài khoản bị khóa.
    function openResetModal(rowForm, fullName, email) {
        var dialog = document.getElementById('resetPasswordModal');
        var input = document.getElementById('newPasswordInput');
        if (!dialog || !input || typeof dialog.showModal !== 'function') return true;

        pendingResetForm = rowForm;

        var title = document.getElementById('modalTargetTitle');
        if (title) title.textContent = 'Đặt lại mật khẩu cho: ' + fullName;
        var desc = document.getElementById('modalTargetDesc');
        if (desc) desc.textContent = 'Tài khoản: ' + email;
        input.value = '';
        input.type = 'password';
        var toggleBtn = document.getElementById('togglePasswordBtn');
        if (toggleBtn) toggleBtn.textContent = '👁️';

        dialog.showModal();
        return false;
    }

    // Chép mật khẩu vào ô ẩn của form dòng rồi gửi form ĐÓ. form.submit() không kích hoạt
    // onsubmit nên không mở lại hộp thoại.
    function confirmReset() {
        if (!pendingResetForm) return;
        var input = document.getElementById('newPasswordInput');
        var hidden = pendingResetForm.querySelector('input[name="newPassword"]');
        if (hidden) hidden.value = input ? input.value : '';
        var form = pendingResetForm;
        pendingResetForm = null;
        closeResetModal();
        form.submit();
    }

    function closeResetModal() {
        var dialog = document.getElementById('resetPasswordModal');
        if (dialog) {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
        }
    }

    function togglePasswordVisibility() {
        var input = document.getElementById('newPasswordInput');
        var btn = document.getElementById('togglePasswordBtn');
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            if (btn) btn.textContent = '🔒';
        } else {
            input.type = 'password';
            if (btn) btn.textContent = '👁️';
        }
    }

    async function suggestPassword() {
        try {
            var res = await fetch('/users/suggest-password');
            if (res.ok) {
                var data = await res.json();
                var input = document.getElementById('newPasswordInput');
                if (input && data.password) {
                    input.value = data.password;
                    input.type = 'text';
                    var btn = document.getElementById('togglePasswordBtn');
                    if (btn) btn.textContent = '🔒';
                }
            }
        } catch (e) {
            console.error('Lỗi khi lấy gợi ý mật khẩu:', e);
        }
    }

    function closeResultModal() {
        var dialog = document.getElementById('resultModal');
        if (dialog) {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
        }
        if (window.history && window.history.replaceState) {
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    }

    function copyPassword(text, btn) {
        if (!text) return;
        var doChangeUi = function () {
            var oldText = btn.textContent;
            btn.textContent = 'Đã sao chép! ✓';
            btn.style.backgroundColor = '#16a34a';
            btn.style.color = '#fff';
            setTimeout(function () {
                btn.textContent = oldText;
                btn.style.backgroundColor = '';
                btn.style.color = '';
            }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(doChangeUi).catch(function () {
                fallbackCopy(text);
                doChangeUi();
            });
        } else {
            fallbackCopy(text);
            doChangeUi();
        }
    }

    function fallbackCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
    }

    document.addEventListener('DOMContentLoaded', function () {
        var resModal = document.getElementById('resultModal');
        if (resModal) {
            if (typeof resModal.showModal === 'function') resModal.showModal();
            else resModal.setAttribute('open', '');
        }

        document.querySelectorAll('dialog.app-modal').forEach(function (dialog) {
            dialog.addEventListener('click', function (e) {
                var rect = dialog.getBoundingClientRect();
                var isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
                                  rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
                if (!isInDialog) {
                    if (dialog.id === 'resultModal') closeResultModal();
                    else closeResetModal();
                }
            });
        });
    });
</script>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }
    // Cờ DUY NHẤT còn lại, và nó chỉ nói "vừa có một lần đặt lại mật khẩu". Kết cục là gì thì
    // đọc từ cookie one-shot — mật khẩu KHÔNG bao giờ nằm trên URL (xem TempPasswordHandoff).
    [SupplyParameterFromQuery(Name = "tempPw")] public string? TempPwFlag { get; set; }
    private ResetHandoff? result;
    private bool hasResult;
    private int pendingCount;
    private List<User> userList = new();
    private List<Role> roleList = new();
    private int currentUid;

    protected override async Task OnInitializedAsync()
    {
        userList = Users.GetAll();
        roleList = Users.GetRoles();
        pendingCount = Users.CountPending();
        if (AuthState != null) currentUid = CurrentUser.Id((await AuthState).User);

        hasResult = TempPwFlag == "1";
        if (hasResult && Http.HttpContext is { } ctx && currentUid > 0)
            result = TempPasswordHandoff.TakeOnce(ctx, DataProtection, currentUid);
    }

    /// <summary>
    /// Thoát chuỗi để nhúng vào literal JavaScript nháy đơn. Ngoài nháy và backslash còn phải
    /// xử lý xuống dòng và U+2028/U+2029 — chúng kết thúc câu lệnh JS y như \n — cùng với "&lt;"
    /// để một giá trị chứa "&lt;/script&gt;" không cắt ngang khối script.
    /// </summary>
    private static string EscapeJs(string? s) =>
        (s ?? "").Replace("\\", "\\\\").Replace("'", "\\'").Replace("\"", "\\\"")
                 .Replace("\r", "\\r").Replace("\n", "\\n")
                 .Replace("\u2028", "\\u2028").Replace("\u2029", "\\u2029")
                 .Replace("<", "\\u003C");
}
